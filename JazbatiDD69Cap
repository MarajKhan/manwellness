<!DOCTYPE html>
<html lang="hi">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dua Dawai | Official</title>


<style>

/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    min-height:100%;
}

body{
    background:#000;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
}


/* =====================================================
   MAIN PAGE
===================================================== */

.page{
    width:100%;
    max-width:720px;
    min-height:100vh;
    margin:auto;
    background:#000;
    overflow:hidden;
}


/* =====================================================
   DUA DAWAI LOGO
===================================================== */

.logo{
    width:220px;
    margin:22px auto 28px;

    text-align:center;

    color:#fff;

    font-size:34px;
    font-weight:900;

    line-height:.85;

    letter-spacing:-2px;
}

.logo .brand{
    color:#fff;
}

.logo .ayurveda{
    margin-top:8px;

    color:#ffad00;

    font-size:20px;

    letter-spacing:2px;

    font-weight:700;
}


/* =====================================================
   FORM BOX
===================================================== */

.form-box{

    margin:0 19px 36px;

    padding:28px 21px 60px;

    border:3px solid #ffad00;

    border-radius:40px;

    background:#000;

}


/* =====================================================
   HEADING
===================================================== */

h1{

    text-align:center;

    color:#fff;

    font-size:clamp(
        25px,
        5.2vw,
        40px
    );

    line-height:1.45;

    font-weight:800;

    letter-spacing:-.5px;

}


/* =====================================================
   DIVIDER
===================================================== */

.divider{

    width:55%;

    height:1px;

    background:#ddd;

    margin:24px auto 37px;

}


/* =====================================================
   LABEL
===================================================== */

label{

    display:block;

    margin-bottom:17px;

    font-size:clamp(
        22px,
        4.6vw,
        33px
    );

    font-weight:700;

}

label span{

    color:#ff0000;

}


/* =====================================================
   INPUT
===================================================== */

input{

    width:100%;

    height:80px;

    padding:0 18px;

    margin-bottom:51px;

    background:#222;

    color:#fff;

    border:2px solid #aaa;

    border-radius:6px;

    outline:none;

    font-size:24px;

    transition:.2s;

}

input:focus{

    border-color:#ffad00;

    box-shadow:
    0 0 0 2px
    rgba(255,173,0,.15);

}


/* =====================================================
   SUBMIT BUTTON
===================================================== */

button{

    border:none;

    background:#ffad00;

    color:#000;

    padding:16px 40px;

    border-radius:50px;

    font-size:29px;

    font-weight:700;

    cursor:pointer;

    transition:.2s;

}

button:hover{

    background:#ffbd24;

    transform:scale(1.02);

}

button:active{

    transform:scale(.98);

}

button:disabled{

    opacity:.65;

    cursor:not-allowed;

    transform:none;

}


/* =====================================================
   MESSAGE
===================================================== */

#message{

    min-height:22px;

    margin-top:15px;

    font-size:15px;

    color:#ffad00;

}


/* =====================================================
   HERO IMAGE
===================================================== */

.hero{

    width:100%;

    position:relative;

    overflow:hidden;

    line-height:0;

}

.hero img{

    width:100%;

    height:auto;

    display:block;

    object-fit:cover;

}


/* =====================================================
   IMAGE LOGO
===================================================== */

.small-logo{

    position:absolute;

    top:18px;

    right:18px;

    color:#fff;

    font-size:21px;

    font-weight:900;

    line-height:.85;

    text-align:center;

    text-shadow:
    0 2px 5px #000;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:480px){

    .logo{

        margin-top:20px;

        margin-bottom:25px;

    }

    .form-box{

        margin-left:18px;

        margin-right:18px;

        padding:25px 17px 55px;

        border-radius:35px;

    }

    input{

        height:72px;

        margin-bottom:43px;

    }

    button{

        font-size:26px;

        padding:14px 37px;

    }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media(max-width:360px){

    .form-box{

        margin-left:14px;

        margin-right:14px;

    }

    h1{

        font-size:23px;

    }

    label{

        font-size:21px;

    }

}

</style>

</head>


<body>


<div class="page">


    <!-- =================================================
         DUA DAWAI LOGO
    ================================================== -->

    <div class="logo">

        <div class="brand">
            Dua Dawai
        </div>

        <div class="ayurveda">
            AYURVEDA & WELLNESS
        </div>

    </div>



    <!-- =================================================
         FORM
    ================================================== -->

    <div class="form-box">


        <h1>

            पावर, जोश और टाइमिंग बढ़ाने के लिए

            <br>

            अपना नाम और नंबर दर्ज करें

        </h1>


        <div class="divider"></div>



        <form id="leadForm">


            <!-- NAME -->

            <label>

                Name <span>*</span>

            </label>


            <input

                type="text"

                id="name"

                name="name"

                autocomplete="name"

                required

            >



            <!-- PHONE -->

            <label>

                Phone Number <span>*</span>

            </label>


            <input

                type="tel"

                id="phone"

                name="phone"

                maxlength="10"

                inputmode="numeric"

                autocomplete="tel"

                required

            >



            <!-- BUTTON -->

            <button

                type="submit"

                id="submitButton"

            >

                Submit

            </button>


            <p id="message"></p>


        </form>

    </div>



    <!-- =================================================
         PRODUCT IMAGE
    ================================================== -->

    <div class="hero">

        <!--

        IMPORTANT:

        GitHub repository me image upload karein.

        Example:

        index.html
        product.jpg

        Uske baad neeche:

        src="product.jpg"

        rakhein.

        -->

        <img

            src="product.jpg"

            alt="Dua Dawai"

        >


        <div class="small-logo">

            Dua

            <br>

            Dawai

        </div>

    </div>


</div>



<script>


/* =====================================================
   GOOGLE SHEET WEB APP URL
===================================================== */


/*

IMPORTANT:

Neeche apna Google Apps Script Web App URL paste karein.

Example:

https://script.google.com/macros/s/XXXXXXXXXXXX/exec

*/

const GOOGLE_SCRIPT_URL =
"https://script.google.com/macros/s/XXXXXXXXXXXX/exec";



/* =====================================================
   FORM SUBMIT
===================================================== */

document
.getElementById("leadForm")
.addEventListener(
    "submit",
    async function(event){

        event.preventDefault();


        /* =============================================
           GET FORM DATA
        ============================================= */

        const name =
            document
            .getElementById("name")
            .value
            .trim();


        const phone =
            document
            .getElementById("phone")
            .value
            .trim();


        const message =
            document
            .getElementById("message");


        const button =
            document
            .getElementById("submitButton");



        /* =============================================
           NAME VALIDATION
        ============================================= */

        if(name === ""){

            message.innerText =
                "Please enter your name.";

            return;

        }



        /* =============================================
           PHONE VALIDATION
        ============================================= */

        if(!/^[6-9][0-9]{9}$/.test(phone)){

            message.innerText =
                "Please enter a valid 10 digit mobile number.";

            return;

        }



        /* =============================================
           LOADING
        ============================================= */

        button.disabled = true;

        button.innerText =
            "Submitting...";

        message.innerText = "";



        /* =============================================
           SEND DATA TO GOOGLE SHEET
        ============================================= */

        try{

            await fetch(

                GOOGLE_SCRIPT_URL,

                {

                    method:"POST",

                    mode:"no-cors",

                    headers:{

                        "Content-Type":
                        "text/plain;charset=utf-8"

                    },

                    body:JSON.stringify({

                        name:name,

                        phone:phone,

                        source:"Dua Dawai Website",

                        page:
                        window.location.href

                    })

                }

            );



            /* =========================================
               SUCCESS
            ========================================= */

            message.innerText =
                "Thank you! Your details have been submitted successfully.";


            message.style.color =
                "#00ff88";


            /* CLEAR FORM */

            document
            .getElementById("leadForm")
            .reset();


        }


        catch(error){

            console.error(error);


            message.innerText =
                "Something went wrong. Please try again.";


            message.style.color =
                "#ff4444";

        }



        /* =============================================
           RESTORE BUTTON
        ============================================= */

        button.disabled = false;

        button.innerText =
            "Submit";

    }

);

</script>


</body>

</html>
