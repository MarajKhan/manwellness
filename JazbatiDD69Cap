<script>

const GOOGLE_SCRIPT_URL =
"https://script.google.com/macros/s/XXXXXXXXXXXX/exec";


document
.getElementById("leadForm")
.addEventListener("submit", async function(event) {

    event.preventDefault();


    const name =
        document
        .getElementById("name")
        .value
        .trim();


    const phone =
        document
        .getElementById("phone")
        .value
        .trim();


    const message =
        document
        .getElementById("message");


    /* NAME VALIDATION */

    if (name === "") {

        message.innerText =
        "Please enter your name.";

        return;
    }


    /* PHONE VALIDATION */

    if (!/^[6-9][0-9]{9}$/.test(phone)) {

        message.innerText =
        "Please enter a valid 10 digit mobile number.";

        return;
    }


    /* BUTTON */

    const button =
        document.querySelector(
            "#leadForm button"
        );


    button.disabled = true;

    button.innerText =
        "Submitting...";


    try {

        await fetch(
            GOOGLE_SCRIPT_URL,
            {

                method: "POST",

                mode: "no-cors",

                headers: {
                    "Content-Type":
                    "text/plain;charset=utf-8"
                },

                body: JSON.stringify({

                    name: name,

                    phone: phone

                })

            }
        );


        message.innerText =
        "Thank you! Your details have been submitted.";


        document
        .getElementById("leadForm")
        .reset();


    } catch (error) {

        console.error(error);

        message.innerText =
        "Something went wrong. Please try again.";

    }


    button.disabled = false;

    button.innerText =
    "Submit";

});

</script>
